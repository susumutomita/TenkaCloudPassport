{
  "name": "tenkacloud-passport",
  "version": "0.1.0-alpha.1",
  "description": "TenkaCloud のイベントで確認済みの手掛かりから人間同士の会話を始める、アカウント不要の Expo アプリ。",
  "author": "Susumu Tomita <oyster880@gmail.com>",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susumutomita/TenkaCloudPassport.git"
  },
  "homepage": "https://github.com/susumutomita/TenkaCloudPassport#readme",
  "bugs": {
    "url": "https://github.com/susumutomita/TenkaCloudPassport/issues"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4",
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "trustedDependencies": [],
  "scripts": {
    "start": "expo start --go",
    "dev": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "bun run build:web",
    "build:web": "expo export --platform web --output-dir dist",
    "build:ios:testflight": "bun add -g --ignore-scripts --safe-chain-skip-minimum-package-age eas-cli@25.3.0 && eas build --platform ios --profile production --non-interactive --auto-submit",
    "submit:ios": "bun add -g --ignore-scripts eas-cli@25.3.0 && eas submit --platform ios --profile production --non-interactive",
    "test": "bun test",
    "test:coverage": "bun test src --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.scripts.json && tsc --noEmit -p tests/responsive/tsconfig.json",
    "expo:check": "expo install --check",
    "clean": "rimraf .expo dist coverage",
    "lint": "bun biome check .",
    "lint:fix": "bun biome check --write .",
    "lint:text": "bun textlint README.md",
    "check:pre-release": "bun scripts/architecture-harness.ts --pre-release --fail-on=error",
    "dup:check": "bun scripts/check-duplication.ts",
    "dup:baseline": "bun scripts/check-duplication.ts --update",
    "generate:app-icons": "bun scripts/generate-app-icons.ts",
    "dead-code": "knip --no-config-hints",
    "lint-staged": "lint-staged",
    "format": "bun biome format --write .",
    "format:check": "bun biome format .",
    "prepare": "husky",
    "test:responsive": "playwright test --config tests/responsive/playwright.config.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@noble/hashes": "2.4.0",
    "@react-native/assets-registry": "0.88.0",
    "expo": "~58.0.17",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.7.0",
    "@types/bun": "1.4.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "jscpd": "5.4.2",
    "jsqr": "^1.4.0",
    "knip": "6.42.1",
    "lint-staged": "17.6.0",
    "pngjs": "7.0.0",
    "rimraf": "^6.1.3",
    "textlint": "15.8.0",
    "textlint-rule-ja-no-abusage": "^3.0.0",
    "textlint-rule-ja-no-inappropriate-words": "^2.0.0",
    "textlint-rule-no-double-negative-ja": "^2.0.1",
    "textlint-rule-no-dropping-the-ra": "^3.0.0",
    "textlint-rule-prefer-tari-tari": "^1.0.3",
    "textlint-rule-preset-ja-spacing": "3.0.4",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-spellcheck-tech-word": "^5.0.0",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  }
}
